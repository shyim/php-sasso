{
    "name": "shyim/sasso",
    "description": "PHP extension wrapping the sasso pure-Rust SCSS to CSS compiler, built with ext-php-rs.",
    "type": "php-ext",
    "license": ["MIT", "Apache-2.0"],
    "keywords": ["sass", "scss", "css", "compiler", "extension"],
    "homepage": "https://github.com/shyim/php-sasso",
    "require": {
        "php": ">=8.2"
    },
    "php-ext": {
        "extension-name": "sasso",
        "support-zts": true,
        "support-nts": true,
        "os-families": ["linux", "darwin", "bsd"],
        "download-url-method": ["pre-packaged-binary"]
    }
}
